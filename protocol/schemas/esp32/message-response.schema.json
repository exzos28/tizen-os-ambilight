{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/exzos28/tizen-os-ambilight/main/protocol/schemas/esp32/message-response.schema.json",
  "title": "Esp32Message",
  "description": "Reply of every POST endpoint, on success and on error (e.g. HTTP 400 from /save/network). Meant to be shown to the user.",
  "type": "object",
  "additionalProperties": false,
  "required": ["message"],
  "properties": {
    "message": { "type": "string", "description": "Human-readable result." }
  }
}
