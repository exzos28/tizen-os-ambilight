{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // @ambilight/protocol and @ambilight/ui are TypeScript source that imports with .ts extensions.
    "allowImportingTsExtensions": true,
    // The kit's files resolve preact to this app's copy (it may have its own for its type-check).
    "paths": {
      "preact": ["./node_modules/preact/src/index.d.ts"],
      "preact/*": ["./node_modules/preact/*/src/index.d.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
