<Project Sdk="Tizen.NET.Sdk/1.1.9">

  <!-- Property Group for .NET Core Project -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      tizen60 (API level 6, Tizen 5.5): the runtime is backward compatible, so
      one build runs on 2020+ TVs. net6.0-tizenX TFMs need the .NET 6 runtime of Tizen 8.0+
      (2024 TVs); on older TVs the service doesn't start (#14).
    -->
    <TargetFramework>tizen60</TargetFramework>
    <LangVersion>10</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      No runtime options here (InvariantGlobalization, ConcurrentGarbageCollection,
      TieredCompilation, …): they only end up in Service.runtimeconfig.json, which Tizen's
      dotnet-launcher does not read — it starts CoreCLR itself with fixed properties. The GC
      mode is set at run time instead (App.Main); see docs/ARCHITECTURE.md, Memory.
    -->
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="lib\" />
    <Folder Include="res\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Apache-2.0; used to encode HyperHDR FlatBuffers messages (HyperHdrProtocol.cs) -->
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
  </ItemGroup>

</Project>
